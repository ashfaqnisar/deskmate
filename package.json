{
  "name": "deskmate",
  "private": true,
  "workspaces": {
    "packages": [
      "backend/*",
      "frontend/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^7",
      "@types/bun": "latest"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '@deskmate/*' dev",
    "dev:api": "bun run --filter @deskmate/api dev",
    "dev:web": "bun run --filter @deskmate/web dev",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "lint:fix": "bun run --filter '*' lint:fix",
    "db:generate": "bun run --filter @deskmate/api db:generate",
    "db:migrate": "bun run --filter @deskmate/api db:migrate",
    "db:studio": "bun run --filter @deskmate/api db:studio"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "catalog:"
  }
}
