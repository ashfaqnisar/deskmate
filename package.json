{
  "name": "deskmate",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^7",
      "@types/bun": "latest"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @deskmate/api dev",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint --type-aware --type-check && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "db:generate": "bun run --filter @deskmate/api db:generate",
    "db:migrate": "bun run --filter @deskmate/api db:migrate",
    "db:studio": "bun run --filter @deskmate/api db:studio"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "catalog:"
  }
}
