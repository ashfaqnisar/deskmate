{
  "$schema": "../../node_modules/oxfmt/configuration_schema.json",
  "extends": ["../../.oxfmtrc.json"],
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "src/typeset.css"],
  "sortImports": {
    "internalPattern": ["~/"],
    "customGroups": [
      {
        "groupName": "bun",
        "elementNamePattern": ["bun", "bun:*"],
        "modifiers": ["value"]
      },
      {
        "groupName": "react",
        "elementNamePattern": ["react", "react/**", "react-dom", "react-dom/**"],
        "modifiers": ["value"]
      },
      {
        "groupName": "deskmate",
        "elementNamePattern": ["@deskmate/**"],
        "modifiers": ["value"]
      },
      {
        "groupName": "tilde-lib",
        "elementNamePattern": ["~/lib", "~/lib/**"],
        "modifiers": ["value"]
      },
      {
        "groupName": "tilde-hooks",
        "elementNamePattern": ["~/hooks", "~/hooks/**"],
        "modifiers": ["value"]
      },
      {
        "groupName": "tilde-shared-shadcn",
        "elementNamePattern": ["~/shared/shadcn", "~/shared/shadcn/**"],
        "modifiers": ["value"]
      },
      {
        "groupName": "tilde-shared-components",
        "elementNamePattern": ["~/shared/components", "~/shared/components/**"],
        "modifiers": ["value"]
      }
    ],
    "groups": [
      "value-builtin",
      "bun",
      "react",
      "value-external",
      "deskmate",
      ["tilde-lib", "tilde-hooks"],
      ["tilde-shared-shadcn", "tilde-shared-components"],
      "value-internal",
      ["value-parent", "value-sibling", "value-index"],
      [
        "type-builtin",
        "type-external",
        "type-import",
        "type-internal",
        "type-subpath",
        "type-parent",
        "type-sibling",
        "type-index"
      ],
      "unknown"
    ]
  },
  "sortTailwindcss": {
    "stylesheet": "./src/styles.css",
    "functions": ["cn", "cva"],
    "preserveWhitespace": true
  }
}
