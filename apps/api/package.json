{
  "name": "@deskmate/api",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev": "bun run --watch index.ts",
    "build": "bun build index.ts --outdir dist --target bun --minify",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:studio": "bunx --bun drizzle-kit studio"
  },
  "dependencies": {
    "@deskmate/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@scalar/fastify-api-reference": "^1.76.0",
    "drizzle-orm": "1.0.0-rc.5",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "openai": "^7.45.0",
    "pino": "^10.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.5",
    "pino-pretty": "^13.2.0"
  }
}
