{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "data",
    "docs",
    "backend/deskmate-api/src/db/migrations"
  ],
  "printWidth": 100,
  "sortImports": {
    "internalPattern": ["~/"],
    "customGroups": [
      {
        "groupName": "bun",
        "elementNamePattern": ["bun", "bun:*"],
        "modifiers": ["value"]
      },
      {
        "groupName": "deskmate",
        "elementNamePattern": ["@deskmate/**"],
        "modifiers": ["value"]
      }
    ],
    "groups": [
      "value-builtin",
      "bun",
      "value-external",
      "deskmate",
      "value-internal",
      ["value-parent", "value-sibling", "value-index"],
      [
        "type-builtin",
        "type-external",
        "type-import",
        "type-internal",
        "type-subpath",
        "type-parent",
        "type-sibling",
        "type-index"
      ],
      "unknown"
    ]
  }
}
